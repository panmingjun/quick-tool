// Quick Tool 通用 Slint 组件定义

import { Button } from "std-widgets.slint";

// 主窗口组件
export component MainWindow inherits Window {
    title: "Quick Tool";
    width: 600px;
    height: 400px;
    background: #1e1e2e;

    // 服务端选择
    in property <string> current-server: "Official";
    in property <string> user-status: "Not logged in";
    in property <[string]> servers: ["Official", "Private"];
    callback server-changed(int);

    // 搜索相关
    in property <string> search-query: "";
    callback search-changed(string);

    // 工具列表
    in property <[string]> tool-names: [];
    in property <int> selected-tool-index: -1;
    callback tool-selected(int);

    // ESC键回调
    callback escape-pressed();

    // 布局
    VerticalLayout {
        padding: 16px;
        spacing: 8px;

        // 服务端和用户状态栏
        HorizontalLayout {
            spacing: 8px;

            // 服务端选择按钮（简化实现）
            Rectangle {
                width: 150px;
                height: 32px;
                border-radius: 4px;
                background: #313244;

                HorizontalLayout {
                    padding: 8px;

                    Text {
                        text: current-server;
                        color: #cdd6f4;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "▼";
                        color: #cdd6f4;
                        horizontal-alignment: right;
                    }
                }

                TouchArea {
                    clicked => { root.server-changed(0); }
                }
            }

            Rectangle {
                horizontal-stretch: 1;
            }

            Text {
                text: user-status;
                color: #cdd6f4;
                vertical-alignment: center;
            }
        }

        // 搜索框
        Rectangle {
            height: 40px;
            border-radius: 8px;
            background: #313244;

            HorizontalLayout {
                padding: 8px;

                Text {
                    text: "🔍";
                    color: #cdd6f4;
                    width: 24px;
                    vertical-alignment: center;
                }

                TextInput {
                    text: search-query;
                    font-size: 14px;
                    color: #cdd6f4;

                    edited => { root.search-changed(self.text); }

                    // ESC键处理：通过 TextInput 的 key-pressed 事件
                    key-pressed(event) => {
                        if event.text == "\u{1b}" {
                            root.escape-pressed();
                            return accept;
                        }
                        return reject;
                    }
                }
            }
        }

        // 工具列表
        Rectangle {
            background: #313244;
            border-radius: 8px;
            vertical-stretch: 1;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                for tool-name[index] in tool-names: Rectangle {
                    height: 32px;
                    border-radius: 4px;
                    background: index == selected-tool-index ? #45475a : transparent;

                    TouchArea {
                        clicked => { root.tool-selected(index); }
                    }

                    HorizontalLayout {
                        padding: 8px;

                        Text {
                            text: tool-name;
                            color: #cdd6f4;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}

// 悬浮窗组件
export component FloatingWindow inherits Window {
    title: "Quick Tool Floating";
    width: 200px;
    height: 150px;
    background: #1e1e2e;
    no-frame: true;

    in property <float> window-opacity: 0.9;
    in property <string> content: "";

    Rectangle {
        border-radius: 8px;
        background: #313244;

        Text {
            text: content;
            color: #cdd6f4;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// 插件运行窗口（在插件列表中选择插件后进入）
export component PluginWindow inherits Window {
    title: "插件";
    width: 420px;
    height: 480px;
    background: #1e1e2e;

    // 插件名称
    in property <string> plugin-name: "插件";
    // 插件渲染容器（动态嵌入插件的 UI 组件）
    in property <component-factory> plugin-factory <=> container.component-factory;

    // 返回插件列表
    callback back-to-list();

    VerticalLayout {
        padding: 24px;
        spacing: 12px;

        Text {
            text: plugin-name;
            color: #89b4fa;
            font-size: 20px;
            horizontal-alignment: center;
        }

        container := ComponentContainer {
            horizontal-stretch: 1;
            vertical-stretch: 1;
        }

        Button {
            text: "返回列表";
            clicked => { root.back-to-list(); }
        }
    }
}